{
  "name": "csc3100-project",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
    "start": "dotenv -e .env.local -- npm run start --workspace=csc3100-frontend",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "expo-sqlite": "~57.0.4",
    "react-native-url-polyfill": "^4.0.0"
  }
}
